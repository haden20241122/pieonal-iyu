# Streamlit Cloud 에서는 앱 설정의 "Secrets" 칸에 아래 내용을 붙여넣습니다.
# 로컬에서 쓰려면 이 파일을 ".streamlit/secrets.toml" 로 복사하세요 (.gitignore 처리됨).
# 이름은 .env.example 과 동일합니다. 값이 없으면 mock 모드로 동작합니다.

DEMO_MODE = "true"
APP_BASE_URL = ""
SURVEY_PRE_URL = ""
SURVEY_POST_URL = ""
SHOP_STAFF_PIN = ""
QR_VALID_HOURS = "72"

MAP_PROVIDER = "folium"
KAKAO_JS_KEY = ""
KAKAO_REST_API_KEY = ""
NAVER_MAP_CLIENT_ID = ""
PUBLIC_DATA_API_KEY = ""
