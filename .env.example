# ─────────────────────────────────────────────────────────────
# 이 파일을 복사해서 ".env" 로 이름을 바꾼 뒤 값을 채우세요.
#   (Windows)  copy .env.example .env
#   (Mac/Linux) cp .env.example .env
# ".env" 는 .gitignore 에 들어 있어 GitHub 에 올라가지 않습니다.
# Streamlit Cloud 에서는 .env 대신 "Settings → Secrets" 에 같은 이름으로 넣으세요.
# 값이 비어 있으면 mock(샘플) 모드로 동작합니다.
# ─────────────────────────────────────────────────────────────

# 데모 모드: true 이면 '프로토타입 도우미'(설문 초기화, QR 목록 등)가 화면에 보입니다.
# 실제 운영 시에는 false 로 바꾸세요.
DEMO_MODE=true

# 배포된 사이트 주소. 넣으면 QR 이 "주소/shop?code=..." 형태가 되어
# 꽃집 직원이 휴대폰 카메라로 스캔하면 바로 인증 화면이 열립니다.
# 예) https://pieonal-iyu.streamlit.app
APP_BASE_URL=

# 설문 URL (Google Forms 등). 비워 두면 앱 안의 샘플 설문(mock)이 열립니다.
SURVEY_PRE_URL=
SURVEY_POST_URL=

# 꽃집 직원 화면(/shop) 접근용 PIN. 비워 두면 PIN 없이 열립니다.
SHOP_STAFF_PIN=

# QR 유효 시간(시간 단위)
QR_VALID_HOURS=72

# ── 외부 API (아직 연결 전) ────────────────────────────────
# 지도 공급자: folium(기본, 키 불필요) | kakao | naver  (kakao/naver 는 components/map_view.py 에 연결 필요)
MAP_PROVIDER=folium
KAKAO_JS_KEY=
KAKAO_REST_API_KEY=
NAVER_MAP_CLIENT_ID=
# 공공데이터포털 건강검진기관 API 키
PUBLIC_DATA_API_KEY=
